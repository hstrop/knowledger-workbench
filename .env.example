# 默认离线确定性模式，不需要密钥
KNOWLEDGER_MODE=offline

# online 模式可接入 DashScope；密钥只放环境变量，不要提交 .env
DASHSCOPE_API_KEY=
KNOWLEDGER_LLM_MODEL=qwen-plus

# 可选：若设置，将作为本地 OCR HTTP 适配器的地址；未设置时不会声称支持 OCR
KNOWLEDGER_OCR_ENDPOINT=

# 工作区与服务配置
KNOWLEDGER_WORKSPACE=./knowledger_data
KNOWLEDGER_HOST=127.0.0.1
KNOWLEDGER_PORT=8010

# 预检索默认参数
KNOWLEDGER_TOP_K=5
KNOWLEDGER_CHUNK_SIZE=500
KNOWLEDGER_CHUNK_OVERLAP=80

